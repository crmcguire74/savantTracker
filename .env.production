VITE_STORAGE_DRIVER=rest
VITE_API_BASE_URL=/api
# Sign-in is detected at start-up: Microsoft Entra roles when the server has
# App Service authentication, the shared test sign-in otherwise. Force one with
# VITE_AUTH_MODE=entra or VITE_AUTH_MODE=local. Assign people the app roles in
# infra/app-roles.json before the first Azure release.
# VITE_AUTH_MODE=auto
