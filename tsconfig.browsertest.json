{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "verify/out",
    "rootDir": "src"
  },
  "include": [
    "src/types.ts",
    "src/constants.ts",
    "src/storage",
    "src/data",
    "src/lib"
  ],
  "exclude": ["src/**/*.test.ts", "src/test-setup.ts"]
}
