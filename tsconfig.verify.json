{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    // The React shim cannot supply contextual types for JSX event handlers,
    // so handler parameters would all report implicit-any. Everything else in
    // strict mode stays on. The real @types/react restores this.
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts", "verify/react-shim.d.ts"]
}
